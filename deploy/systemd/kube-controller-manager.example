# /etc/kubernetes/kube-controller-manager — EnvironmentFile for the service.
# The apiserver serves HTTPS only (unless started with --insecure), so this
# needs an https:// URL and a credential. e.g.:
#   APISERVER_URL=https://127.0.0.1:6443
#   KUBE_CONTROLLER_MANAGER_ARGS=--certificate-authority /etc/kubernetes/pki/ca.crt --client-certificate /etc/kubernetes/pki/controller-manager.crt --client-key /etc/kubernetes/pki/controller-manager.key
# Every flag, with its default, is in the README.
APISERVER_URL=https://127.0.0.1:6443
KUBE_CONTROLLER_MANAGER_ARGS=
